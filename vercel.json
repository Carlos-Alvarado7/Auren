{
  "version": 2,
  "installCommand": "bun install",
  "buildCommand": "bun run --cwd Angular build",
  "outputDirectory": "Angular/dist/auren-menu/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://auren-7v7l.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
